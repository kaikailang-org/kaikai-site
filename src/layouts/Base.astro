---
import '../styles/global.css';
import Header from '../components/Header.astro';
import Footer from '../components/Footer.astro';
import { getLangFromUrl, pathInLang, t, type Lang } from '../i18n/ui';
import { blogFeedPath } from '../lib/blog';

interface Props {
  title: string;
  description?: string;
  lang?: Lang;
  /** Passed through to the header for pages whose counterpart in the other
   *  edition does not share this path. */
  altPath?: string;
}

const { title, description, lang: explicitLang, altPath } = Astro.props;
const lang: Lang = explicitLang ?? getLangFromUrl(Astro.url);
const desc =
  description ??
  (lang === 'es'
    ? 'Lenguaje funcional con efectos algebraicos. Diseñado para programar con y por agentes.'
    : 'A functional language with algebraic effects. Designed to be written with and by agents.');

// The same counterpart the header's language switch links to.
const otherLang: Lang = lang === 'es' ? 'en' : 'es';
const otherPath =
  altPath ?? pathInLang(Astro.url.pathname.replace(/^\/en/, '') || '/', otherLang);
const site = 'https://kaikai-lang.org';
const esPath = lang === 'es' ? Astro.url.pathname : otherPath;
const enPath = lang === 'en' ? Astro.url.pathname : otherPath;
---

<!doctype html>
<html lang={lang}>
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>{title}</title>
    <meta name="description" content={desc} />
    <link
      rel="alternate"
      type="application/rss+xml"
      title={t(lang)('blog.feedTitle')}
      href={blogFeedPath(lang)}
    />

    <link rel="alternate" hreflang="es" href={`${site}${esPath}`} />
    <link rel="alternate" hreflang="en" href={`${site}${enPath}`} />
    <link rel="alternate" hreflang="x-default" href={`${site}${esPath}`} />

    {lang === 'es' && (
      <script is:inline define:vars={{ enPath }}>
        // A visitor arriving from outside the site gets the English edition
        // when they chose it with the language switch, or, with no choice
        // stored, when their browser ranks English above Spanish. Moving
        // around inside the site never redirects, and neither do crawlers.
        try {
          var fromOutside =
            !document.referrer || new URL(document.referrer).origin !== location.origin;
          var crawler = /bot|crawl|spider|slurp|preview/i.test(navigator.userAgent);
          if (fromOutside && !crawler) {
            var choice = null;
            try {
              choice = localStorage.getItem('kaikai-lang');
            } catch (e) {
              /* no storage: fall back to the browser's languages */
            }
            if (!choice) {
              var langs = navigator.languages || [navigator.language || ''];
              for (var i = 0; i < langs.length; i++) {
                var l = String(langs[i]).toLowerCase();
                if (l.indexOf('es') === 0 || l.indexOf('en') === 0) {
                  choice = l.slice(0, 2);
                  break;
                }
              }
            }
            if (choice === 'en') location.replace(enPath + location.search + location.hash);
          }
        } catch (e) {
          /* stay on the Spanish page */
        }
      </script>
    )}

    <link rel="icon" type="image/x-icon" href="/honu/honu-favicon.ico" />
    <link rel="icon" type="image/png" sizes="32x32" href="/honu/honu-32.png" />
    <link rel="icon" type="image/png" sizes="192x192" href="/honu/honu-192.png" />
    <link rel="apple-touch-icon" sizes="180x180" href="/honu/honu-apple-touch-icon.png" />

    <meta name="theme-color" content="#0d3b66" media="(prefers-color-scheme: light)" />
    <meta name="theme-color" content="#0f1419" media="(prefers-color-scheme: dark)" />

    <meta property="og:title" content={title} />
    <meta property="og:description" content={desc} />
    <meta property="og:image" content="https://kaikai-lang.org/kaikai-og-1200x630.png" />
    <meta property="og:image:width" content="1200" />
    <meta property="og:image:height" content="630" />
    <meta property="og:type" content="website" />
    <meta property="og:url" content={`https://kaikai-lang.org${Astro.url.pathname}`} />

    <meta name="twitter:card" content="summary_large_image" />
    <meta name="twitter:title" content={title} />
    <meta name="twitter:description" content={desc} />
    <meta name="twitter:image" content="https://kaikai-lang.org/kaikai-og-1200x630.png" />

    <script is:inline>
      // Runs before first paint, so a stored choice never flashes the other
      // theme. No stored choice means no attribute at all, and the CSS falls
      // back to prefers-color-scheme.
      try {
        var saved = localStorage.getItem('kaikai-theme');
        if (saved === 'dark' || saved === 'light') {
          document.documentElement.setAttribute('data-theme', saved);
        }
      } catch (e) {
        /* localStorage unavailable (private mode): keep the OS preference */
      }
    </script>

    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
    <link
      rel="stylesheet"
      href="https://fonts.googleapis.com/css2?family=Inter:wght@400;500;600;700&family=Source+Serif+4:opsz,wght@8..60,400;8..60,600&family=JetBrains+Mono:wght@400;500&display=swap"
    />
  </head>
  <body>
    <Header lang={lang} altPath={altPath} />
    <main>
      <slot />
    </main>
    <Footer lang={lang} />
  </body>
</html>
