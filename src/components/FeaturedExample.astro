---
import { t, pathInLang, type Lang } from '../i18n/ui';
import fs from 'node:fs';
import path from 'node:path';
import { highlightKai } from '../lib/highlight';
import { parseSnippet } from '../lib/snippet';
import CodeWindow from './CodeWindow.astro';

interface Props {
  lang: Lang;
}
const { lang } = Astro.props;
const tt = t(lang);

// The hero already carries the effects example, so the featured slot shows a
// different face of the language. The full set lives on /examples.
const FILE = '06_pipes.kai';

const source = fs.readFileSync(
  path.resolve(process.cwd(), 'src/snippets', lang, FILE),
  'utf-8',
);
const parsed = parseSnippet(source);
const html = await highlightKai(parsed.code);
const command = parsed.command?.replace(/examples\/quickstart\//, '');
const outputText = parsed.output.join('\n');
---

<section class="featured">
  <div class="container featured-grid">
    <div class="featured-text">
      <h2>{tt('featured.title')}</h2>
      <p class="intro">{tt('featured.intro')}</p>
      <a class="all-link" href={pathInLang('/examples', lang)}>
        {tt('featured.seeAll')} <span aria-hidden="true">→</span>
      </a>
    </div>

    <CodeWindow filename={FILE} html={html} command={command} output={outputText} />
  </div>
</section>

<style>
  .featured {
    padding-block: var(--space-16);
  }
  .featured-grid {
    display: grid;
    grid-template-columns: minmax(0, 1fr) minmax(0, 2.2fr);
    gap: var(--space-12);
    align-items: center;
  }
  .featured-text h2 {
    margin-bottom: var(--space-3);
  }
  .intro {
    color: var(--fg-muted);
    margin-bottom: var(--space-6);
  }
  .all-link {
    font-weight: 600;
    color: var(--accent);
  }

  @media (max-width: 62rem) {
    .featured-grid {
      grid-template-columns: minmax(0, 1fr);
      gap: var(--space-6);
    }
  }
</style>
