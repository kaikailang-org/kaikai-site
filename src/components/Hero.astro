---
import { t, pathInLang, type Lang } from '../i18n/ui';
import { highlightKai } from '../lib/highlight';
import { links } from '../lib/links';
import CodeWindow from './CodeWindow.astro';
import InstallCommand from './InstallCommand.astro';

interface Props {
  lang: Lang;
}
const { lang } = Astro.props;
const tt = t(lang);

const heroSnippet = `effect Log {
  log(msg: String) : Unit
}

fn greet(name: String) : Unit / Log {
  Log.log("hello, #{name}")
}

fn main() {
  handle {
    greet("kaikai")
    greet("world")
  } with Log {
    log(msg, resume) -> {
      println("[INFO] #{msg}")
      resume(())
    }
  }
}`;

const heroHtml = await highlightKai(heroSnippet);
const heroOutput = '[INFO] hello, kaikai\n[INFO] hello, world';
---

<section class="hero backdrop">
  <div class="container hero-grid">
    <div class="hero-text">
      <div class="hero-logo">
        <img class="logo-light" src="/kaikai-logo.svg" alt="kaikai" width="760" height="240" />
        <img class="logo-dark" src="/kaikai-logo-dark.svg" alt="kaikai" width="760" height="240" />
      </div>
      <a class="pill" href="#agents">
        <span class="pill-dot" aria-hidden="true"></span>
        {tt('hero.pill')} <span aria-hidden="true">→</span>
      </a>
      <h1>
        <span>{tt('hero.title.line1')}</span>{' '}
        <span class="warm">{tt('hero.title.line2')}</span>
      </h1>
      <p class="lead">{tt('hero.lead')}</p>

      <InstallCommand lang={lang} />

      <div class="cta-row">
        <a class="btn" href={pathInLang('/get-started', lang)}>
          {tt('hero.cta.start')}
        </a>
        <a class="btn secondary" href={pathInLang('/examples', lang)}>
          {tt('hero.cta.examples')}
        </a>
        <a class="text-link" href={pathInLang('/book', lang)}>
          {tt('hero.cta.book')} <span aria-hidden="true">→</span>
        </a>
        <a class="text-link" href={links.github.kaikai} rel="noopener">
          GitHub <span aria-hidden="true">→</span>
        </a>
      </div>
      <p class="why-name">
        <a href={pathInLang('/about', lang)}>{tt('hero.whyName')}</a>
      </p>
    </div>

    <CodeWindow
      filename="effect.kai"
      html={heroHtml}
      command="kai run effect.kai"
      output={heroOutput}
    />
  </div>
</section>

<style>
  .hero {
    padding-block: var(--space-16) var(--space-24);
  }
  .hero-grid {
    display: grid;
    grid-template-columns: minmax(0, 1.1fr) minmax(0, 1fr);
    gap: var(--space-12);
    align-items: center;
  }
  .hero-logo img {
    display: block;
    width: 190px;
    height: auto;
    margin: 0 0 var(--space-6) -0.9rem;
  }
  /* Follows the OS unless the reader picked a theme; then the choice wins. */
  .hero-logo .logo-dark { display: none; }
  @media (prefers-color-scheme: dark) {
    :root:not([data-theme='light']) .hero-logo .logo-light { display: none; }
    :root:not([data-theme='light']) .hero-logo .logo-dark { display: block; }
  }
  :root[data-theme='dark'] .hero-logo .logo-light { display: none; }
  :root[data-theme='dark'] .hero-logo .logo-dark { display: block; }
  .pill {
    display: inline-flex;
    align-items: center;
    gap: 0.5rem;
    margin-bottom: var(--space-4);
    padding: 0.3rem 0.8rem;
    border: 1px solid var(--border-strong);
    border-radius: 999px;
    background: var(--bg-elevated);
    color: var(--fg);
    font-size: 0.85rem;
    font-weight: 500;
  }
  .pill:hover {
    border-color: var(--accent-warm);
    text-decoration: none;
  }
  .pill-dot {
    width: 0.5rem;
    height: 0.5rem;
    border-radius: 50%;
    background: var(--accent-soft);
  }
  h1 {
    font-size: clamp(2rem, 4vw, 3.1rem);
    line-height: 1.08;
    text-wrap: balance;
    letter-spacing: -0.04em;
    font-weight: 800;
    margin-bottom: var(--space-6);
  }
  h1 .warm {
    color: var(--accent-warm);
  }
  .lead {
    font-size: clamp(1.05rem, 1.5vw, 1.2rem);
    line-height: 1.6;
    color: var(--fg-muted);
    max-width: 46ch;
    margin-bottom: var(--space-8);
  }
  .cta-row {
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    gap: var(--space-3) var(--space-4);
    margin-top: var(--space-6);
  }
  .text-link {
    font-weight: 600;
    font-size: 0.95rem;
    color: var(--fg);
  }
  .text-link:hover {
    color: var(--accent);
    text-decoration: none;
  }
  .why-name {
    font-size: 0.88rem;
    margin: var(--space-6) 0 0;
  }
  .why-name a {
    color: var(--fg-muted);
    border-bottom: 1px dotted var(--fg-subtle);
  }
  .why-name a:hover {
    color: var(--accent);
    border-bottom-color: var(--accent);
    text-decoration: none;
  }

  @media (max-width: 880px) {
    .hero-grid { grid-template-columns: minmax(0, 1fr); }
    .hero { padding-block: var(--space-8) var(--space-12); }
  }
</style>
