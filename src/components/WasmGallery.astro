---
import { t, pathInLang, type Lang } from '../i18n/ui';
import fs from 'node:fs';
import path from 'node:path';
import { highlightKai } from '../lib/highlight';
import { parseSnippet } from '../lib/snippet';
import { wasmDemos } from '../lib/wasm-demos';

interface Props {
  lang: Lang;
  /** Number of the first demo, continuing the examples above it. */
  start: number;
}
const { lang, start } = Astro.props;
const tt = t(lang);

const items = await Promise.all(
  wasmDemos.map(async (d, i) => {
    const source = fs.readFileSync(
      path.resolve(process.cwd(), 'src/wasm', lang, `${d.id}.kai`),
      'utf-8',
    );
    return {
      ...d,
      n: String(start + i).padStart(2, '0'),
      file: `${d.id}.kai`,
      src: `/wasm/${lang}/${d.id}/${d.id}.html`,
      title: tt(`web.item.${d.id}.title` as never),
      desc: tt(`web.item.${d.id}.desc` as never),
      hint: tt(`web.item.${d.id}.hint` as never),
      html: await highlightKai(parseSnippet(source).code),
    };
  }),
);
---

<section class="web" id="web">
    <header class="web-head">
      <p class="eyebrow">{tt('web.eyebrow')}</p>
      <h2 class="web-title"><a href="#web">{tt('web.title')}</a></h2>
      <p class="lead">{tt('web.lead')}</p>
      <p class="note">{tt('web.note')}</p>
    </header>

    {items.map((it) => (
      <article class="demo" id={it.id}>
        <div class="ex-head">
          <span class="ex-n" aria-hidden="true">{it.n}</span>
          <div>
            <h3><a href={`#${it.id}`}>{it.title}</a></h3>
            <p class="desc">{it.desc}</p>
          </div>
        </div>

        <div class="demo-body">
          <div class="live">
            <div class="chrome">
              <span>{tt('web.live')}</span>
              <span class="hint">{it.hint}</span>
            </div>
            <iframe
              src={it.src}
              title={it.title}
              loading="lazy"
              style={`height: ${it.height}px`}
            />
          </div>

          <div class="window">
            <div class="chrome"><span class="filename">{it.file}</span></div>
            <div class="code-body" set:html={it.html} />
          </div>
        </div>

        <pre class="cmd"><code>$ kai build --target=wasm32-browser {it.file} -o {it.id}</code></pre>
      </article>
    ))}

    <p class="more">
      {tt('web.more')}{' '}
      <a href={pathInLang('/book/apG-webassembly', lang)}>{tt('web.more.link')}</a>
    </p>
</section>

<style>
  /* A second part of the examples page, set off from the quickstart above. */
  .web {
    padding-top: var(--space-12);
    border-top: 1px solid var(--border);
    scroll-margin-top: var(--space-8);
  }
  .web-head {
    margin-bottom: var(--space-12);
  }
  .web-title {
    margin: 0 0 var(--space-3);
    font-size: 2rem;
  }
  .web-title a {
    color: inherit;
    text-decoration: none;
  }
  .note {
    margin: var(--space-4) 0 0;
    color: var(--fg-subtle);
    font-size: 0.9rem;
    max-width: 62ch;
  }

  .demo {
    margin-bottom: var(--space-16);
    scroll-margin-top: var(--space-8);
  }
  .ex-head {
    display: flex;
    gap: var(--space-4);
    align-items: flex-start;
    margin-bottom: var(--space-6);
  }
  .ex-n {
    font-family: var(--font-mono);
    font-size: 2rem;
    line-height: 1;
    font-weight: 600;
    color: var(--accent-warm);
    opacity: 0.55;
  }
  .demo h3 {
    margin: 0 0 0.2rem;
    font-size: 1.5rem;
  }
  .demo h3 a {
    color: inherit;
    text-decoration: none;
  }
  .demo h3 a:hover { color: var(--accent); }
  .desc {
    margin: 0;
    color: var(--fg-muted);
    font-size: 1.02rem;
    line-height: 1.55;
    max-width: 62ch;
  }

  /* The running program first; its source beside it, scrolling on its own. */
  .demo-body {
    display: grid;
    grid-template-columns: minmax(0, 1fr) minmax(0, 1.2fr);
    gap: var(--space-4);
    align-items: start;
  }
  .live,
  .window {
    background: var(--code-bg);
    border: 1px solid var(--code-border);
    border-radius: var(--radius-lg);
    overflow: hidden;
  }
  .chrome {
    display: flex;
    gap: var(--space-3);
    padding: 0.6rem 1rem;
    border-bottom: 1px solid var(--code-border);
    background: rgba(255, 255, 255, 0.03);
    font-family: var(--font-mono);
    font-size: 0.72rem;
    letter-spacing: 0.06em;
    text-transform: uppercase;
    color: rgba(230, 237, 243, 0.55);
  }
  .hint {
    margin-left: auto;
    text-transform: none;
    letter-spacing: 0;
    color: #ffd166;
  }
  .filename {
    text-transform: none;
    letter-spacing: 0;
    color: rgba(230, 237, 243, 0.8);
  }
  iframe {
    display: block;
    width: 100%;
    border: 0;
    background: #0d1117;
  }
  .code-body {
    max-height: 30rem;
    overflow: auto;
  }
  /* Shiki sets background-color inline; !important is the only override. */
  .code-body :global(pre.shiki) {
    background: transparent !important;
    margin: 0;
    padding: var(--space-4) var(--space-6);
    font-size: 0.8rem;
  }
  .cmd {
    margin: var(--space-3) 0 0;
    padding: 0;
    background: none;
    font-family: var(--font-mono);
    font-size: 0.8rem;
    color: var(--fg-subtle);
    overflow-x: auto;
  }

  .more {
    padding-top: var(--space-8);
    border-top: 1px solid var(--border);
    color: var(--fg-muted);
  }

  @media (max-width: 62rem) {
    .demo-body { grid-template-columns: 1fr; }
    .code-body { max-height: 22rem; }
  }
  @media (max-width: 40rem) {
    .ex-n { font-size: 1.5rem; }
  }
</style>
