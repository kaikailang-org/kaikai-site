---
import { t, type Lang } from '../i18n/ui';
import { getBlogPosts, blogPostPath, formatPostDate } from '../lib/blog';

interface Props {
  lang: Lang;
}
const { lang } = Astro.props;
const tt = t(lang);
const posts = await getBlogPosts(lang);
---

<article class="blog-index page backdrop">
  <div class="container">
    <header>
      <p class="eyebrow">kaikai</p>
      <h1>{tt('nav.blog')}</h1>
      <p class="lead">{tt('blog.lead')}</p>
    </header>

    {posts.length === 0 ? (
      <p class="empty">{tt('blog.empty')}</p>
    ) : (
      <ul class="posts">
        {posts.map((post) => (
          <li>
            <a href={blogPostPath(post)}>
              <p class="meta">
                <time datetime={post.data.date.toISOString().slice(0, 10)}>
                  {formatPostDate(post.data.date, lang)}
                </time>
                {post.data.draft && <span class="draft">{tt('blog.draft')}</span>}
              </p>
              <h2>{post.data.title}</h2>
              {post.data.description && <p class="desc">{post.data.description}</p>}
            </a>
          </li>
        ))}
      </ul>
    )}
  </div>
</article>

<style>
  .empty {
    color: var(--fg-muted);
  }
  .posts {
    list-style: none;
    margin: 0;
    padding: 0;
    display: grid;
    gap: var(--space-4);
    max-width: 48rem;
  }
  .posts a {
    display: block;
    padding: var(--space-6);
    background: var(--bg-elevated);
    border: 1px solid var(--border);
    border-radius: var(--radius-lg);
    color: var(--fg);
    transition: border-color 120ms ease, transform 120ms ease;
  }
  .posts a:hover {
    border-color: var(--border-strong);
    transform: translateY(-2px);
    text-decoration: none;
  }
  .meta {
    display: flex;
    align-items: center;
    gap: var(--space-3);
    margin-bottom: var(--space-2);
    font-family: var(--font-mono);
    font-size: 0.78rem;
    color: var(--accent-warm);
  }
  .draft {
    padding: 0.05rem 0.5rem;
    border: 1px solid currentColor;
    border-radius: 999px;
    text-transform: uppercase;
    letter-spacing: 0.08em;
    font-size: 0.68rem;
  }
  .posts h2 {
    margin-bottom: var(--space-2);
    font-size: 1.5rem;
  }
  .desc {
    margin: 0;
    color: var(--fg-muted);
    line-height: 1.6;
  }
</style>
