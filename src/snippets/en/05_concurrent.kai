# Two cooperative fibers.
#
# `spawn.spawn` schedules a fiber but does not run it yet — the
# scheduler picks it up at the next yield point. `spawn.yield`
# is an explicit cooperation point: the current fiber suspends and
# the scheduler picks the next one ready.
#
# `loop.repeat(n) { ... }` is an ordinary stdlib function, not a
# keyword: the body is a trailing lambda, so its effect row (here
# `Stdout + Spawn`) flows straight out into the caller's row.
#
# The strict A/B rotation below holds on a single scheduler thread.
#
#   $ KAI_THREADS=1 kai run examples/quickstart/05_concurrent.kai
#   A
#   B
#   A
#   B
#   A
#   B

import spawn
import loop

fn worker(tag: String, n: Int) : Unit / Stdout + Spawn {
  loop.repeat(n) {
    println(tag)
    spawn.yield()
  }
}

fn main() {
  # Trailing-lambda form: `spawn.spawn { ... }` instead of
  # `spawn.spawn(() => ...)`.
  let f = spawn.spawn { worker("B", 3) }
  worker("A", 3)
  spawn.await(f)
}
