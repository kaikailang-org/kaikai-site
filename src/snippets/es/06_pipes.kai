# Tuberías: cuatro operadores, cuatro intenciones.
#
#   |>   aplica        le pasa el valor de la izquierda a una función
#   |    transforma    aplica la función a cada elemento
#   ||   aplana        transforma cada elemento y junta los resultados
#   |?   filtra        conserva los elementos que cumplen la condición
#
#   $ kai run examples/quickstart/06_pipes.kai
#   total=20

fn cuadrado(n: Int) : Int = n * n

fn divisores(n: Int) : [Int] = [1, n]

fn es_par(n: Int) : Bool = n % 2 == 0

fn main() {
  # `[1..4]` es un literal de rango: no hace falta un acumulador a mano.
  # `[1..10..2]` agrega un paso.
  let total = [1..4]                  # [1, 2, 3, 4]
    | cuadrado                        # [1, 4, 9, 16]      (transforma)
    || divisores                      # [1, 1, 1, 4, 1, 9, 1, 16] (aplana)
    |? es_par                         # [4, 16]            (filtra)
    |> list.sum                       # 20                 (aplica)

  println("total=#{total}")
}
