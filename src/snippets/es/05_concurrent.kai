# Dos fibras que se turnan.
#
# `spawn.spawn` deja una fibra lista para correr, pero todavía no la
# ejecuta: el planificador la toma en el siguiente punto de cesión.
# `spawn.yield` es justamente eso, un punto de cesión explícito. La
# fibra actual se detiene y el planificador elige la próxima que esté
# lista.
#
# `loop.repeat(n) { ... }` es una función común de la biblioteca
# estándar, no una palabra reservada. Su cuerpo es una lambda final,
# así que sus efectos (aquí `Stdout + Spawn`) pasan directo a quien
# la llama.
#
# El turno estricto A/B de abajo se cumple con un solo hilo en el
# planificador.
#
#   $ KAI_THREADS=1 kai run examples/quickstart/05_concurrent.kai
#   A
#   B
#   A
#   B
#   A
#   B

import spawn
import loop

fn trabajador(tag: String, n: Int) : Unit / Stdout + Spawn {
  loop.repeat(n) {
    println(tag)
    spawn.yield()
  }
}

fn main() {
  # Con lambda final escribes `spawn.spawn { ... }` en vez de
  # `spawn.spawn(() => ...)`.
  let f = spawn.spawn { trabajador("B", 3) }
  trabajador("A", 3)
  spawn.await(f)
}
