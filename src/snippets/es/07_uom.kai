# Unidades de medida: cuentas que no confunden monedas.
#
# Las unidades van en el tipo. El compilador no te deja sumar USD con
# EUR: para pasar de una moneda a otra hay que dar un paso explícito.
#
# `unit` no es un agregado especial del lenguaje: crea un habitante
# del kind `Measure`. El ejemplo de kinds muestra qué se gana con eso.
#
#   $ kai run examples/quickstart/07_uom.kai
#   balance=845.1 USD

unit USD
unit EUR

fn convertir_a_usd(monto: Real<EUR>, tasa: Real<USD/EUR>) : Real<USD>
  = monto * tasa

fn main() {
  let salario   : Real<USD> = 1000.0<USD>
  let mercado   : Real<USD> =  250.0<USD>
  let comision  : Real<USD> =    5.0<USD>
  let reembolso : Real<EUR> =   91.0<EUR>
  let tasa      : Real<USD/EUR> = 1.10<USD/EUR>

  let balance = salario - mercado - comision + convertir_a_usd(reembolso, tasa)

  # 1000 - 250 - 5 + 100.1 = 845.1 USD
  println("balance=#{balance}")
}
