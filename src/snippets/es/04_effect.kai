# Un efecto propio y su manejador.
#
# Los efectos algebraicos son el sello de kaikai. Una función declara
# en su tipo los efectos que usa, y quien la llama tiene dos caminos:
# declararlos también, o instalar un manejador que los resuelva.
#
# Aquí `Log` es un efecto con una sola operación, `log(msg)`.
# `saludar` la usa sin saber CÓMO se registra el mensaje. Eso lo
# decide `main` al llamarla: le antepone `[INFO]` y lo envía a la
# salida estándar.
#
#   $ kai run examples/quickstart/04_effect.kai
#   [INFO] hello, kaikai
#   [INFO] hello, world

effect Log {
  log(msg: String) : Unit
}

fn saludar(nombre: String) : Unit / Log {
  # `#{...}` inserta el valor en el texto, sin concatenar a mano.
  Log.log("hello, #{nombre}")
}

fn main() {
  handle {
    saludar("kaikai")
    saludar("world")
  } with Log {
    log(msg, resume) -> {
      println("[INFO] #{msg}")
      resume(())
    }
  }
}
