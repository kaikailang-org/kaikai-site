# Efecto propio con su handler.
#
# Los efectos algebraicos son el diferenciador de kaikai: una función
# declara en su tipo los efectos que usa, y quien la llame debe o bien
# declararlos también, o instalar un handler que los provea.
#
# Abajo, `Log` es un efecto propio con una sola operación, `log(msg)`.
# `saludar` la usa pero no dice CÓMO se registra. `main` lo decide al
# momento de llamar: prefija cada mensaje con `[INFO]` y lo manda a la
# salida estándar.
#
#   $ kai run examples/quickstart/04_effect.kai
#   [INFO] hello, kaikai
#   [INFO] hello, world

effect Log {
  log(msg: String) : Unit
}

fn saludar(nombre: String) : Unit / Log {
  # `#{...}` interpola dentro del string — sin concatenación manual.
  Log.log("hello, #{nombre}")
}

fn main() {
  handle {
    saludar("kaikai")
    saludar("world")
  } with Log {
    log(msg, resume) -> {
      println("[INFO] #{msg}")
      resume(())
    }
  }
}
