# FizzBuzz.
#
# El clásico, sin escribir un solo bucle. Un tipo suma clasifica cada
# número y una cadena de operadores hace el recorrido: `[1..15]` es un
# literal de rango, `|` transforma cada elemento y `|>` le pasa la
# lista completa a una función.
#
#   $ kai run examples/quickstart/02_fizzbuzz.kai
#   1
#   2
#   Fizz
#   4
#   Buzz
#   ...
#   FizzBuzz

type Tag
  = Ambos
  | Fizz
  | Buzz
  | Otro(Int)

# Cada rama lleva su propia condición con una guarda, así que no
# necesitas una cascada de `if / else if`.
fn clasificar(n: Int) : Tag = match n {
  n if n % 15 == 0 -> Ambos
  n if n % 3 == 0  -> Fizz
  n if n % 5 == 0  -> Buzz
  n                -> Otro(n)
}

fn etiqueta(c: Tag) : String = match c {
  Ambos    -> "FizzBuzz"
  Fizz     -> "Fizz"
  Buzz     -> "Buzz"
  # `#{expr}` inserta cualquier valor mostrable dentro del texto.
  Otro(n)  -> "#{n}"
}

fn main() {
  [1..15]
    | clasificar              # transforma: [Int] -> [Tag]
    | etiqueta                # transforma: [Tag] -> [String]
    |> list.foreach(println)  # aplica: imprime cada línea
}
